{
  "schemaVersion": 1,
  "name": "ASM-011 camera gimbal mount assembly benchmark",
  "description": "Intermediate hierarchical CAD assembly benchmark for a small camera gimbal mount with base, yaw motor, pitch fork, camera block, lens, pivot pins, and bosses.",
  "tasks": [
    {
      "id": "asm_011_camera_gimbal_mount_assembly",
      "kind": "assembly",
      "target": "models/benchmarks/asm_011_camera_gimbal_mount_assembly.py",
      "prompt": "Create a compact camera gimbal mount assembly with a base plate, mounting bosses, yaw motor, pitch fork arms, camera block, lens barrel, pivot pin, spacers, and cable guard. Use robust simple parts.",
      "assumptions": [
        "Intermediate assembly benchmark intended to broaden non-tank visual/mechanical coverage with robust primitives.",
        "Repeated occurrences are functional or visually essential, not tiny decorative detail.",
        "Generated STEP, GLB, topology, and component artifacts are produced by the CAD pipeline and are not hand-edited source of truth."
      ],
      "checks": [
        {
          "type": "step_exists",
          "weight": 8
        },
        {
          "type": "topology_exists",
          "weight": 8
        },
        {
          "type": "glb_exists",
          "weight": 8
        },
        {
          "type": "valid_shape",
          "weight": 12
        },
        {
          "type": "bbox_size",
          "expected": [
            55,
            38,
            52
          ],
          "tolerance": [
            8,
            8,
            8
          ],
          "weight": 20
        },
        {
          "type": "selector_count",
          "selector": "occurrence",
          "min": 18,
          "weight": 12
        },
        {
          "type": "selector_count",
          "selector": "shape",
          "min": 12,
          "weight": 10
        },
        {
          "type": "selector_count",
          "selector": "face",
          "min": 70,
          "weight": 8
        },
        {
          "type": "surface_count",
          "surface_type": "cylinder",
          "min": 12,
          "weight": 8
        },
        {
          "type": "volume_range",
          "min": 5000,
          "max": 120000,
          "weight": 8
        },
        {
          "type": "assembly_occurrence_count",
          "scope": "top_level",
          "min": 3,
          "weight": 10
        },
        {
          "type": "assembly_occurrence_count",
          "scope": "leaf",
          "min": 12,
          "weight": 10
        },
        {
          "type": "named_occurrence_contains",
          "names": [
            "gimbal_base_module",
            "yaw_motor_module",
            "pitch_fork_module",
            "camera_block",
            "pivot_pin",
            "mounting_boss"
          ],
          "weight": 14
        },
        {
          "type": "repeated_component_count",
          "contains": "mounting_boss",
          "min": 4,
          "weight": 10
        },
        {
          "type": "repeated_component_count",
          "contains": "fork_arm",
          "min": 2,
          "weight": 10
        },
        {
          "type": "repeated_component_count",
          "contains": "pivot_pin",
          "min": 1,
          "weight": 8
        }
      ]
    }
  ]
}
