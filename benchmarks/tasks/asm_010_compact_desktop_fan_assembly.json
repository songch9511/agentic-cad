          "weight": 8
        },
        {
          "type": "valid_shape",
          "weight": 12
        },
        {
          "type": "bbox_size",
          "expected": [
            60,
            32,
            65
          ],
          "tolerance": [
            8,
            8,
            8
          ],
          "weight": 20
        },
        {
          "type": "selector_count",
          "selector": "occurrence",
          "min": 18,
          "weight": 12
        },
        {
          "type": "selector_count",
          "selector": "shape",
          "min": 14,
          "weight": 10
