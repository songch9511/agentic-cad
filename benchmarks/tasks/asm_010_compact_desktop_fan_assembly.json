{
  "schemaVersion": 1,
  "name": "ASM-010 compact desktop fan assembly benchmark",
  "description": "Intermediate hierarchical CAD assembly benchmark for a compact desktop fan with base, stand, fan housing, repeated blades, grille bars, and switch.",
